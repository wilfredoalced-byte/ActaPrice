<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        style="@style/TituloSeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I. DATOS DEL ESTABLECIMIENTO" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expediente" />
    <EditText
        android:id="@+id/et_expediente"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de expediente"
        android:inputType="text" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agente fiscalizado" />
    <EditText
        android:id="@+id/et_agente_fiscalizado"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Razón social / nombre del agente"
        android:inputType="text" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Código Osinergmin" />
    <EditText
        android:id="@+id/et_codigo_osinergmin"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código del establecimiento"
        android:inputType="text" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registro de Hidrocarburos" />
    <EditText
        android:id="@+id/et_registro_hidrocarburos"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de registro"
        android:inputType="text" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fecha de diligencia" />
    <EditText
        android:id="@+id/et_fecha_diligencia"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Toque para seleccionar la fecha"
        android:focusable="false"
        android:clickable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">
            <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hora Apertura" />
            <EditText
                android:id="@+id/et_hora_apertura"
                style="@style/CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="00:00"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hora Cierre" />
            <EditText
                android:id="@+id/et_hora_cierre"
                style="@style/CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="00:00"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dirección" />
    <EditText
        android:id="@+id/et_direccion"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dirección completa" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distrito" />
            <EditText android:id="@+id/et_distrito" style="@style/CampoTexto" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">
            <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provincia" />
            <EditText android:id="@+id/et_provincia" style="@style/CampoTexto" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Departamento" />
            <EditText android:id="@+id/et_departamento" style="@style/CampoTexto" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUC / DNI" />
    <EditText
        android:id="@+id/et_ruc_dni"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number" />

    <TextView style="@style/EtiquetaCampo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teléfono / Fax" />
    <EditText
        android:id="@+id/et_telefono_fax"
        style="@style/CampoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="phone" />

</merge>